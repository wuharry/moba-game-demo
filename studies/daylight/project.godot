config_version=5
[application]
config/name="Daylight Cliff Study P34-D"
run/main_scene="res://calibration_daylight/daylight.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1120
window/size/window_height_override=630

[rendering]
renderer/rendering_method="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096

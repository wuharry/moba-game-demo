config_version=5
[application]
config/name="Godot Environment Art Study"
run/main_scene="res://refinement_gallery.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1120
window/size/window_height_override=630

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
